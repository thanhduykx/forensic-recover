{
  "version": "1.0.0",
  "description": "Forensic Recover Versioned Signature Database (header/footer + structural validator mappings)",
  "rules": [
    {
      "sig_id": "jpg-jfif-exif",
      "family": "image",
      "mime": "image/jpeg",
      "ext": "jpg",
      "header_hex": "ffd8ff",
      "header_offset": 0,
      "footer_hex": "ffd9",
      "min_len": 128,
      "max_len": 67108864,
      "validator_ref": "jpeg"
    },
    {
      "sig_id": "png-std",
      "family": "image",
      "mime": "image/png",
      "ext": "png",
